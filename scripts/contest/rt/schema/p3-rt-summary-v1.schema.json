{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p3-rt-summary-v1",
  "title": "P3 realtime summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "matrix_id", "scenario", "seed", "feature_state", "status", "missing_events", "exactly_once", "metrics"],
  "properties": {
    "schema_version": {"const": "p3-rt-summary-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "matrix_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "enum": [7, 19, 43]},
    "feature_state": {"type": "string", "enum": ["off", "on"]},
    "status": {"type": "string", "enum": ["complete", "blocked", "incomplete"]},
    "missing_events": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exactly_once": {"type": "boolean"},
    "metrics": {"type": "object"}
  }
}
