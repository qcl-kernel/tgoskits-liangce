source "$(ZEPHYR_BASE)/Kconfig"

config DUAL_BOOT_ID
	string "Contest dual-guest boot identifier"
	default "unknown"
	help
	  Boot identifier bound by the contest runner before build.

config CONTEST_NET_MODE
	string "Contest network mode (l3-smoke/udp-echo/tcp-listen)"
	default "l3-smoke"
	help
	  P4 network mode selected at build time.
