# Trusted Bash data consumed by scripts/contest/run_axvisor_baseline.sh.
# Keep this file declarative: assignments only, with no command substitutions.

# Repository-relative directories.
AXVISOR_DIR_REL="os/axvisor"
RESULTS_ROOT_REL="results/baseline/runs"

# Paths below are relative to os/axvisor.
BUILD_CONFIG_REL="configs/board/qemu-aarch64.toml"
QEMU_CONFIG_REL=".github/workflows/qemu-aarch64.toml"
LINUX_QEMU_CONFIG_REL="configs/contest/qemu-aarch64-linux-baseline.toml"

# Bound every QEMU invocation so an unsuccessful guest cannot run forever.
TIMEOUT_SECONDS="900"

ARCEOS_SETUP_GUEST="arceos"
ARCEOS_IMAGE_NAME="qemu_aarch64_arceos"
ARCEOS_VMCONFIG_REL="tmp/vmconfigs/arceos-aarch64-qemu-smp1.generated.toml"
ARCEOS_SUCCESS_MARKER="Hello, world!"

LINUX_SETUP_GUEST="linux"
LINUX_IMAGE_NAME="qemu_aarch64_linux"
LINUX_VMCONFIG_REL="tmp/vmconfigs/linux-aarch64-qemu-smp1.generated.toml"
LINUX_SUCCESS_MARKER="test pass!"
