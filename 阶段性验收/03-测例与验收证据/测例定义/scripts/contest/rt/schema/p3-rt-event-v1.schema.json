{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p3-rt-event-v1",
  "title": "P3 realtime event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "endpoint",
    "scenario",
    "transport",
    "session_id",
    "sequence",
    "request_id",
    "sample_index",
    "event",
    "monotonic_ns",
    "value",
    "unit",
    "outcome",
    "clock_domain",
    "raw_counter_ticks",
    "counter_frequency_hz",
    "clock_mapping_id",
    "vm_id",
    "vcpu_id",
    "pcpu_id",
    "interrupt_id",
    "path_variant",
    "path_id",
    "feature_state",
    "trace_sequence"
  ],
  "properties": {
    "schema_version": {"const": "p3-rt-event-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "transport": {"type": ["string", "null"]},
    "session_id": {"type": ["integer", "null"], "minimum": 0},
    "sequence": {"type": ["integer", "null"], "minimum": 0},
    "request_id": {"type": ["integer", "null"], "minimum": 0},
    "sample_index": {"type": ["integer", "null"], "minimum": 0},
    "event": {"type": "string", "minLength": 1},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "outcome": {"type": ["string", "null"]},
    "clock_domain": {"type": "string", "minLength": 1},
    "raw_counter_ticks": {"type": "integer", "minimum": 0},
    "counter_frequency_hz": {"type": "integer", "minimum": 1},
    "clock_mapping_id": {"type": "string", "minLength": 1},
    "vm_id": {"type": ["integer", "null"], "minimum": 0},
    "vcpu_id": {"type": ["integer", "null"], "minimum": 0},
    "pcpu_id": {"type": ["integer", "null"], "minimum": 0},
    "interrupt_id": {"type": ["integer", "null"], "minimum": 0},
    "path_variant": {"type": "string", "minLength": 1},
    "path_id": {"type": "string", "minLength": 1},
    "feature_state": {"type": "string", "minLength": 1},
    "trace_sequence": {"type": "integer", "minimum": 0}
  }
}
